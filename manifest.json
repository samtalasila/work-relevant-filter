{
  "manifest_version": 3,
  "name": "Work-Relevant Filter",
  "version": "0.1.0",
  "description": "Blocks Reddit pages that aren't relevant to your work, judged by an LLM on Groq.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Work-Relevant Filter",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
